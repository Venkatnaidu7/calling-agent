# Test environment overrides.
# Loaded by docker-compose.test.yml (api/worker containers) and by
# `make test` (host-side pytest) via the Makefile's `test` target.
# These point at the isolated test Postgres/Redis started by
# docker-compose.test.yml (ports 5433 / 6380), NOT the main dev stack.

APP_ENV=test
APP_SECRET_KEY=test-secret-key-not-for-production-0000000000000000000000000000
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_voice_platform_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

JWT_SECRET_KEY=test-jwt-secret-key-not-for-production-000000000000000000000000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=sk-test-placeholder
TWILIO_ACCOUNT_SID=ACtestplaceholder00000000000000
TWILIO_AUTH_TOKEN=test-placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder

CORS_ALLOWED_ORIGINS=http://localhost:3000
